---
import '../styles/landing.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const manual = (page: string) => `${base}/${page}/`;
const home = '/';
const github = 'https://github.com/isamisushi/kikimimi';
const bars = [24, 38, 29, 52, 43, 65, 46, 34, 58, 78, 51, 68, 41, 60, 84, 70, 48, 62, 92, 73, 57, 80, 66, 45];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="See what your AI coding agents actually do. kikimimi (kkmm) tracks Claude Code and Codex CLI activity locally. Get started with the macOS app or CLI." />
    <meta name="theme-color" content="#f6f7f2" />
    <meta property="og:title" content="kikimimi — See what your agents actually do." />
    <meta property="og:description" content="Tokens, tools, and sessions. A clearer picture of your Claude Code and Codex CLI activity." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={new URL(home, Astro.site)} />
    <link rel="canonical" href={new URL(home, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>kikimimi / kkmm — See what your agents actually do.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header>
        <a class="brand" href={home} aria-label="kikimimi home"><span class="brand-mark" aria-hidden="true">((</span> kikimimi<span class="brand-alias">/ kkmm</span></a>
        <nav aria-label="Main navigation"><a href="/overview">Log in ↗</a><a class="features-link" href="#features">Features</a><a href={manual('overview')}>Docs ↗</a><a class="nav-download" href="#download">Download ↓</a></nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> A LITTLE LISTENER FOR YOUR AGENTS</p>
            <h1 id="hero-title">Your agents at work.<br /><span>Now in the clear.</span></h1>
            <p class="hero-description">What they do. Where they get stuck. How much they use.<br class="desktop-break" />kikimimi quietly listens, so you can see the whole picture.</p>
            <div class="hero-actions"><a class="button primary" href="#download">Get the macOS app ↓</a><a class="text-link" href={manual('quickstart')}>Start with the CLI ↗</a></div>
            <p class="hero-note">Start locally. No account required.</p>
          </div>
          <div class="signal-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="listener">((</div><span class="signal-tag tag-one">Claude Code <i></i></span><span class="signal-tag tag-two">Codex CLI <i></i></span><span class="signal-caption">LESS GUESSING. MORE LISTENING.</span></div>
        </section>
        <section class="preview-section" aria-label="Illustrative dashboard preview">
          <div class="preview-caption"><span>YOUR AGENTS, IN PERSPECTIVE.</span><span>Illustration · Sample data</span></div>
          <div class="dashboard">
            <aside class="dash-sidebar" aria-hidden="true"><div class="dash-logo">(( <b>kkmm</b></div><div class="workspace">⌘ &nbsp; Local workspace</div><div class="selected">◫ &nbsp; Overview</div><div>▤ &nbsp; Sessions</div><div>◇ &nbsp; Models</div><div>⌁ &nbsp; Tools</div><div>⊞ &nbsp; MCP</div><div>✳ &nbsp; Skills</div><small><span class="status-dot"></span> Stored locally</small></aside>
            <div class="dash-main"><div class="dash-heading"><div><span class="small-label">WORKSPACE / LOCAL</span><h2>Overview</h2></div><span class="period">Last 7 days ▾</span></div>
              <div class="metrics"><div><span>Sessions</span><strong>128</strong><small>Claude Code + Codex CLI</small></div><div><span>Total tokens</span><strong>2.4<span>M</span></strong><small>Input & output</small></div><div><span>Recorded cost</span><strong><span>$</span>18.62</strong><small>Reported API usage cost</small></div></div>
              <div class="chart-heading"><h3>Token activity</h3><span><i></i> Claude Code <i></i> Codex CLI</span></div>
              <div class="chart" aria-hidden="true"><div class="chart-labels"><span>400k</span><span>200k</span><span>0</span></div><div class="chart-bars">{bars.map((height, i) => <div class="bar" style={`--height:${height}%;--split:${25 + i % 4 * 8}%`}><span></span></div>)}</div></div>
              <div class="chart-days"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
              <div class="dash-bottom"><span><span class="status-dot"></span> Your activity. On your machine.</span><span>localhost ↗</span></div>
            </div>
          </div>
        </section>
        <div class="compatibility"><span>WORKS WITH YOUR WORKFLOW</span><strong>Claude Code</strong><span class="plus">+</span><strong>Codex CLI</strong><span class="compat-note">The agents you already use.</span></div>
        <section id="features" class="features section-space" aria-labelledby="features-title">
          <div class="section-heading"><p class="eyebrow">01 / A CLEARER PICTURE</p><h2 id="features-title">Go beyond “it’s running.”</h2><p>Less guesswork. More insight from the activity on your machine.</p></div>
          <div class="feature-grid">
            <article><span class="feature-icon" aria-hidden="true">↗</span><h3>Know what you use.</h3><p>See tokens and recorded costs for each session. Understand which models you use and where your usage goes.</p><a href={manual('queries')}>Explore usage ↗</a></article>
            <article><span class="feature-icon" aria-hidden="true">⌁</span><h3>Spot the stuck loops.</h3><p>Find repeated tool failures and retries. Look back at the sessions where your agents struggled to make progress.</p><a href={manual('quickstart')}>Review sessions ↗</a></article>
            <article><span class="feature-icon" aria-hidden="true">⊞</span><h3>Make room for context.</h3><p>See idle MCP servers and skill invocations. Estimate schema overhead and find opportunities to refine your setup.</p><a href={manual('improvement-loop')}>Find ways to improve ↗</a></article>
          </div>
        </section>
        <section class="privacy" aria-labelledby="privacy-title"><div><p class="eyebrow">LOCAL FIRST. QUIET BY DESIGN.</p><h2 id="privacy-title">Activity, recorded.<br />Your content, private.</h2></div><div><p>kikimimi records metadata: tool names, durations, and token counts. It does not collect prompts, file contents, or command lines.</p><p>Data lands in local Parquet files first. Cloud sharing is opt-in. No proxy or TLS interception required.</p><a class="text-link" href={manual('privacy')}>Read about privacy ↗</a></div></section>
        <section id="download" class="section-space download" aria-labelledby="download-title"><div class="section-heading"><p class="eyebrow">02 / START LISTENING</p><h2 id="download-title">Meet your Mac’s little listener.</h2><p>An app or a terminal. Start the way you like to work.</p></div>
          <div class="download-grid"><article class="download-card mac-card"><div class="card-top"><span class="platform-icon" aria-hidden="true">((</span><span class="pill" id="release-badge">Development preview</span></div><h3>kikimimi for macOS</h3><p>Manage collection from your menu bar and open your local dashboard in one app. CLI and DuckDB included.</p><div id="mac-downloads" hidden><a class="button primary" id="download-arm">Apple Silicon ↓</a><a class="button secondary" id="download-intel">Intel Mac ↓</a></div><p class="release-status" id="release-status" role="status">Check GitHub Releases for signed macOS installers.</p><a class="text-link" href={`${github}/releases`} id="release-fallback">View GitHub Releases ↗</a><small>macOS 11 or later · Apple Silicon / Intel<br />Move the app to Applications before enabling collection.</small></article>
          <article class="download-card cli-card"><div class="card-top"><span class="platform-icon terminal-icon" aria-hidden="true">&gt;_</span><span class="pill">CLI</span></div><h3>At home in your terminal.</h3><p>Install with Homebrew. Use <code>kkmm</code> as a shorter name for the same CLI.</p><pre aria-label="CLI installation and startup commands"><code><span># Install</span>
brew install isamisushi/tap/kikimimi
brew install duckdb

<span># Start listening</span>
kkmm init
kkmm web</code></pre><a class="text-link" href={manual('installation')}>Installation guide ↗</a><small>DuckDB is required for CLI queries and the local dashboard.</small></article></div>
        </section>
        <section class="closing"><span class="brand-mark" aria-hidden="true">((</span><h2>Better building starts with listening.</h2><a class="text-link" href={github}>Follow along on GitHub ↗</a></section>
      </main>
      <footer><a class="brand" href={home}>kikimimi <span class="brand-alias">/ kkmm</span></a><span>Built in the open. Stored close to you.</span><div><a href="/overview">Dashboard</a><a href={manual('overview')}>Docs</a><a href={manual('privacy')}>Privacy</a><a href={github}>GitHub ↗</a></div></footer>
    </div>
    <script>
      import { findDesktopRelease } from '../lib/desktop-release.js';
      const status = document.getElementById('release-status')!;
      status.textContent = 'Checking for macOS downloads…';
      findDesktopRelease().then((release) => {
        if (!release) {
          status.textContent = 'The macOS app is in development preview. No public DMG is available yet. Try the CLI to get started today.';
          return;
        }
        const arm = document.getElementById('download-arm') as HTMLAnchorElement;
        const intel = document.getElementById('download-intel') as HTMLAnchorElement;
        arm.href = release.urls[0]!;
        intel.href = release.urls[1]!;
        document.getElementById('mac-downloads')!.hidden = false;
        document.getElementById('release-badge')!.textContent = `v${release.version}`;
        status.textContent = 'Choose the DMG for your Mac’s chip. You can check it in About This Mac.';
      }).catch(() => {
        status.textContent = 'Could not check for downloads. Visit GitHub Releases for macOS availability.';
        document.getElementById('release-badge')!.textContent = 'macOS';
      });
    </script>
  </body>
</html>
