{
  "name": "kikimimi-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts KikimimiJa out/kikimimi-ja.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster": "remotion still src/index.ts KikimimiJa out/poster.png --frame=200",
    "check": "tsc --noEmit",
    "capture": "node scripts/capture.mjs",
    "demo:seed": "python3 demo/seed.py",
    "demo:serve": "node demo/server.mjs",
    "demo:verify": "node demo/verify.mjs",
    "demo:record": "node demo/record.mjs",
    "demo:render": "remotion render src/index.ts KikimimiDemoJa out/kikimimi-demo-ja.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "demo:poster": "remotion still src/index.ts KikimimiDemoJa out/demo-poster.png --frame=600",
    "demo:vertical": "remotion render src/index.ts KikimimiDemoVerticalJa out/kikimimi-demo-vertical-ja.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "demo:vertical:poster": "remotion still src/index.ts KikimimiDemoVerticalJa out/demo-vertical-poster.png --frame=600",
    "demo:vertical:record": "DEMO_PORTRAIT=1 node demo/record.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "remotion": "4.0.532",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3",
    "playwright": "1.56.1"
  }
}
