---
import '../styles/landing.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const manual = (page: string) => `${base}/${page}/`;
const home = '/';
const github = 'https://github.com/isamisushi/kikimimi';
const bars = [24, 38, 29, 52, 43, 65, 46, 34, 58, 78, 51, 68, 41, 60, 84, 70, 48, 62, 92, 73, 57, 80, 66, 45];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="See who uses which AI coding agents, understand cost drivers, and spot risky detours. kikimimi gives teams visibility into Claude Code and Codex CLI activity." />
    <meta name="theme-color" content="#f6f7f2" />
    <meta property="og:title" content="kikimimi — Your team’s agents. Usage, cost, and risk." />
    <meta property="og:description" content="Understand team adoption, find opportunities to reduce waste, and investigate permission detours and retry loops." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={new URL(home, Astro.site)} />
    <link rel="canonical" href={new URL(home, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>kikimimi / kkmm — Your team’s agents. Usage, cost, and risk.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header>
        <a class="brand" href={home} aria-label="kikimimi home"><span class="brand-mark" aria-hidden="true">((</span> kikimimi<span class="brand-alias">/ kkmm</span></a>
        <nav aria-label="Main navigation"><a href="/overview">Log in ↗</a><a class="features-link" href="#features">For teams</a><a href={manual('overview')}>Docs ↗</a><a class="nav-download" href="#download">Download ↓</a></nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> VISIBILITY FOR TEAMS BUILDING WITH AI</p>
            <h1 id="hero-title">Your team’s agents.<br /><span>Usage. Cost. Risk.</span></h1>
            <p class="hero-description">See who’s using which agents, models, and tools. Find what drives cost, and surface risky detours in how the work gets done.</p>
            <div class="hero-actions"><a class="button primary" href={manual('teams')}>Explore team setup ↗</a><a class="text-link" href="#download">Try it on your Mac ↓</a></div>
            <p class="hero-note">Start locally. Share metadata with your team when you choose.</p>
          </div>
          <div class="signal-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="listener">((</div><span class="signal-tag tag-one">Claude Code <i></i></span><span class="signal-tag tag-two">Codex CLI <i></i></span><span class="signal-caption">LESS GUESSING. MORE LISTENING.</span></div>
        </section>
        <section class="preview-section" aria-label="Illustrative dashboard preview">
          <div class="preview-caption"><span>YOUR TEAM’S ACTIVITY, IN PERSPECTIVE.</span><span>Illustration · Sample data</span></div>
          <div class="dashboard">
            <aside class="dash-sidebar" aria-hidden="true"><div class="dash-logo">(( <b>kkmm</b></div><div class="workspace">⌘ &nbsp; Team workspace</div><div class="selected">◫ &nbsp; Overview</div><div>▤ &nbsp; Sessions</div><div>◇ &nbsp; Models</div><div>⌁ &nbsp; Tools</div><div>⊞ &nbsp; MCP</div><div>✳ &nbsp; Skills</div><small><span class="status-dot"></span> Metadata only</small></aside>
            <div class="dash-main"><div class="dash-heading"><div><span class="small-label">WORKSPACE / TEAM</span><h2>Team overview</h2></div><span class="period">Last 7 days ▾</span></div>
              <div class="metrics"><div><span>Sessions</span><strong>128</strong><small>Claude Code + Codex CLI</small></div><div><span>Total tokens</span><strong>2.4<span>M</span></strong><small>Input & output</small></div><div><span>Recorded cost</span><strong><span>$</span>18.62</strong><small>Reported API usage cost</small></div></div>
              <div class="chart-heading"><h3>Token activity</h3><span><i></i> Claude Code <i></i> Codex CLI</span></div>
              <div class="chart" aria-hidden="true"><div class="chart-labels"><span>400k</span><span>200k</span><span>0</span></div><div class="chart-bars">{bars.map((height, i) => <div class="bar" style={`--height:${height}%;--split:${25 + i % 4 * 8}%`}><span></span></div>)}</div></div>
              <div class="chart-days"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
              <div class="dash-bottom"><span><span class="status-dot"></span> Shared team activity. Metadata only.</span><span>Team workspace ↗</span></div>
            </div>
          </div>
        </section>
        <div class="compatibility"><span>WORKS WITH YOUR WORKFLOW</span><strong>Claude Code</strong><span class="plus">+</span><strong>Codex CLI</strong><span class="compat-note">The agents you already use.</span></div>
        <section id="features" class="features section-space" aria-labelledby="features-title">
          <div class="section-heading"><p class="eyebrow">01 / BUILT FOR TEAMS</p><h2 id="features-title">Know who uses what. Understand the cost.</h2><p>Give engineering leads a shared view of adoption, usage, and opportunities to reduce waste.</p></div>
          <div class="feature-grid">
            <article><span class="feature-icon" aria-hidden="true">↗</span><h3>See who’s using what.</h3><p>Review member usage, then drill into sessions to see the agents, models, and tools involved. Understand how AI coding is used across your team.</p><a href={manual('teams')}>Explore team visibility ↗</a></article>
            <article><span class="feature-icon" aria-hidden="true">⌁</span><h3>Find the cost drivers.</h3><p>Compare token usage and reported costs. Investigate retry loops, model choices, and unused MCP overhead to decide where to optimize.</p><a href={manual('improvement-loop')}>Find optimization opportunities ↗</a></article>
            <article><span class="feature-icon" aria-hidden="true">⊞</span><h3>Share with clear boundaries.</h3><p>Choose which repos sync to your team. Per-member usage and cross-member session drilldowns are restricted to admins and owners, with access recorded in an audit log.</p><a href={manual('teams')}>See team access controls ↗</a></article>
          </div>
          <div class="team-followup"><p>Start with the Members view, then investigate the sessions behind the numbers. Cost visibility depends on what each agent reports; missing cost stays unknown.</p><a class="button secondary" href="/team">Open your team workspace ↗</a></div>
        </section>
        <section id="risk" class="risk-section" aria-labelledby="risk-title">
          <div class="risk-copy">
            <p class="eyebrow">02 / WHEN AGENTS FIND ANOTHER WAY</p>
            <h2 id="risk-title">Spot warning signs<br />in how work gets done.</h2>
            <p>Agents can keep going after a tool fails or a permission is denied. kikimimi surfaces those detours so your team can review what happened along the way.</p>
            <ul class="risk-signals">
              <li><strong>Permission detours</strong><span>A denied tool followed by a Bash or browser call.</span></li>
              <li><strong>Repeated failures</strong><span>Retry spirals and repeated permission denials.</span></li>
              <li><strong>Unexpected overhead</strong><span>Context growth and unusually slow MCP tool calls.</span></li>
            </ul>
            <a class="text-link" href={manual('queries') + '#patterns'}>See the detection patterns ↗</a>
          </div>
          <div class="risk-example">
            <p class="example-label">ILLUSTRATIVE SEQUENCE · SAME SESSION</p>
            <ol class="event-sequence">
              <li><span class="event-marker">01</span><div><strong>WebFetch denied</strong><span>A tool call hits a permission boundary.</span></div></li>
              <li><span class="event-marker">02</span><div><strong>Bash called afterward</strong><span>Within the next five recorded events.</span></div></li>
              <li><span class="event-marker">03</span><div><strong>Potential detour flagged</strong><span>Review the session and the tool sequence.</span></div></li>
            </ol>
            <p class="risk-note">A sequence-based signal: it does not establish intent or prove that a restriction was bypassed. kikimimi observes recorded activity; it does not block actions or detect every risk.</p>
          </div>
        </section>
        <section class="privacy" aria-labelledby="privacy-title"><div><p class="eyebrow">LOCAL FIRST. QUIET BY DESIGN.</p><h2 id="privacy-title">Activity, recorded.<br />Your content, private.</h2></div><div><p>kikimimi records metadata: tool names, durations, and token counts. It does not collect prompts, file contents, or command lines.</p><p>Data lands in local Parquet files first. Cloud sharing is opt-in. No proxy or TLS interception required.</p><a class="text-link" href={manual('privacy')}>Read about privacy ↗</a></div></section>
        <section id="download" class="section-space download" aria-labelledby="download-title"><div class="section-heading"><p class="eyebrow">03 / START LISTENING</p><h2 id="download-title">Meet your Mac’s little listener.</h2><p>An app or a terminal. Start the way you like to work.</p></div>
          <div class="download-grid"><article class="download-card mac-card"><div class="card-top"><span class="platform-icon" aria-hidden="true">((</span><span class="pill" id="release-badge">Development preview</span></div><h3>kikimimi for macOS</h3><p>Manage collection from your menu bar and open your local dashboard in one app. CLI and DuckDB included.</p><div id="mac-downloads" hidden><a class="button primary" id="download-arm">Apple Silicon ↓</a><a class="button secondary" id="download-intel">Intel Mac ↓</a></div><p class="release-status" id="release-status" role="status">Check GitHub Releases for signed macOS installers.</p><a class="text-link" href={`${github}/releases`} id="release-fallback">View GitHub Releases ↗</a><small>macOS 11 or later · Apple Silicon / Intel<br />Move the app to Applications before enabling collection.</small></article>
          <article class="download-card cli-card"><div class="card-top"><span class="platform-icon terminal-icon" aria-hidden="true">&gt;_</span><span class="pill">CLI</span></div><h3>At home in your terminal.</h3><p>Install with Homebrew. Use <code>kkmm</code> as a shorter name for the same CLI.</p><pre aria-label="CLI installation and startup commands"><code><span># Install</span>
brew install isamisushi/tap/kikimimi
brew install duckdb

<span># Start listening</span>
kkmm init
kkmm web</code></pre><a class="text-link" href={manual('installation')}>Installation guide ↗</a><small>DuckDB is required for CLI queries and the local dashboard.</small></article></div>
        </section>
        <section class="closing"><span class="brand-mark" aria-hidden="true">((</span><h2>Give your team visibility as agents do more.</h2><a class="text-link" href={github}>Follow along on GitHub ↗</a></section>
      </main>
      <footer><a class="brand" href={home}>kikimimi <span class="brand-alias">/ kkmm</span></a><span>Built in the open. Stored close to you.</span><div><a href="/overview">Dashboard</a><a href={manual('overview')}>Docs</a><a href={manual('privacy')}>Privacy</a><a href={github}>GitHub ↗</a></div></footer>
    </div>
    <script>
      import { findDesktopRelease } from '../lib/desktop-release.js';
      const status = document.getElementById('release-status')!;
      status.textContent = 'Checking for macOS downloads…';
      findDesktopRelease().then((release) => {
        if (!release) {
          status.textContent = 'The macOS app is in development preview. No public DMG is available yet. Try the CLI to get started today.';
          return;
        }
        const arm = document.getElementById('download-arm') as HTMLAnchorElement;
        const intel = document.getElementById('download-intel') as HTMLAnchorElement;
        arm.href = release.urls[0]!;
        intel.href = release.urls[1]!;
        document.getElementById('mac-downloads')!.hidden = false;
        document.getElementById('release-badge')!.textContent = `v${release.version}`;
        status.textContent = 'Choose the DMG for your Mac’s chip. You can check it in About This Mac.';
      }).catch(() => {
        status.textContent = 'Could not check for downloads. Visit GitHub Releases for macOS availability.';
        document.getElementById('release-badge')!.textContent = 'macOS';
      });
    </script>
  </body>
</html>
